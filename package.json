{
  "name": "fitness-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node -e \"if (+process.versions.node.split('.')[0] < 24) { console.error('PulseFit needs Node 24 (found ' + process.version + '). Run: nvm use'); process.exit(1) }\"",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:import-json": "tsx scripts/import-json.ts",
    "parse-data": "python3 scripts/parse_health_data.py",
    "check-personal-data": "python3 scripts/check_personal_data.py",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@ant-design/plots": "2.6.8",
    "antd": "6.6.5",
    "better-sqlite3": "13.0.3",
    "dayjs": "1.11.13",
    "drizzle-orm": "0.45.4",
    "framer-motion": "12.43.0",
    "leaflet": "1.9.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
